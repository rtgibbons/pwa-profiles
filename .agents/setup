#!/usr/bin/env bash
set -euo pipefail

# Prepare a fresh Amp orb for this Manifest V3 Chrome extension.
# No package manager, lockfile, env file, or backing service.

log() { printf '%s\n' "$*"; }

time_step() {
  local label="$1"
  shift
  log "==> $label"
  local start=$SECONDS
  "$@"
  log "    ($((SECONDS - start))s)"
}

packages_missing() {
  local pkg
  for pkg in "$@"; do
    if ! dpkg -s "$pkg" >/dev/null 2>&1; then
      return 0
    fi
  done
  return 1
}

install_packages() {
  sudo apt-get update
  sudo apt-get install -y --no-install-recommends "$@"
}

validate_json() {
  npm run check
}

check_javascript() {
  npm test
}

confirm_tools() {
  local tool
  for tool in node python3 zip unzip jq; do
    command -v "$tool" >/dev/null
    log "  ok $tool ($(command -v "$tool"))"
  done
}

needed=(zip)
if packages_missing "${needed[@]}"; then
  time_step "Install system packages: ${needed[*]}" install_packages "${needed[@]}"
else
  log "==> System packages already installed"
fi

time_step "Confirm toolchain" confirm_tools
time_step "Validate extension JSON" validate_json
time_step "Syntax-check JavaScript" check_javascript

log "Setup complete."
